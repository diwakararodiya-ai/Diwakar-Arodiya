<resources>
    <!-- Base Application Theme -->
    <style name="Theme.KisaanCare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/nav_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash / Launcher Theme for instantaneous startup -->
    <style name="Theme.KisaanCare.Splash" parent="Theme.KisaanCare">
        <item name="android:windowBackground">@color/primary_emerald</item>
        <item name="android:statusBarColor">@color/primary_emerald</item>
        <item name="android:navigationBarColor">@color/primary_emerald</item>
    </style>
</resources>
